#, python-format
msgid ""
"  %(finished)s of %(audience)s finished, %(started)s started, %(waiting)s "
"not yet"
msgstr ""
"  أنهى %(finished)s من %(audience)s، وبدأ %(started)s، ولم يبدأ %(waiting)s "
"بعد"

#, python-format
msgid "  %(finished)s finished of %(started)s who started"
msgstr "  أنهى %(finished)s من %(started)s بدأوا"

#, python-format
msgid "  %(count)s stopped and have not come back for %(days)s days"
msgstr "  توقّف %(count)s ولم يعودوا منذ %(days)s أيام"

#, python-format
msgid "  most who stop, stop around %(at)s"
msgstr "  أغلب من يتوقفون يتوقفون عند %(at)s"

#, python-format
msgid ""
"  %(at)s is replayed %(ratio)sx more than the rest: worth explaining again?"
msgstr ""
"  الجزء عند %(at)s يُعاد %(ratio)s مرات أكثر من الباقي: يستحق شرحًا إضافيًا؟"

#, python-format
msgid "Lesson report: %s"
msgstr "تقرير الحصة: %s"

msgid "A lesson is waiting for you"
msgstr "في حصة مستنياك"

#, python-format
msgid "You have not started \"%s\" yet."
msgstr "لسه ما بدأتش «%s»."

msgid "This link has expired. Reload the page."
msgstr "انتهت صلاحية هذا الرابط. أعد تحميل الصفحة."

msgid "Playback is paused on this account. Please contact support."
msgstr "تم إيقاف التشغيل مؤقتًا على هذا الحساب. يرجى التواصل مع الدعم."

msgid "This account is watching on another device."
msgstr "هذا الحساب يشاهد الآن على جهاز آخر."

msgid "Forbidden"
msgstr "غير مسموح"

msgid "Too many requests."
msgstr "طلبات كثيرة جدًا."
