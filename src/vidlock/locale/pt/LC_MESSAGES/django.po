msgid "Protection"
msgstr "Proteção"

msgid "Sealed"
msgstr "Selado"

msgid "Sealing…"
msgstr "Selando…"

msgid "Failed"
msgstr "Falhou"

msgid "Not sealable"
msgstr "Não selável"

msgid "Not sealed"
msgstr "Não selado"

msgid "Duration"
msgstr "Duração"

msgid "Seal again (unsealed or failed videos)"
msgstr "Selar novamente (vídeos não selados ou com falha)"

#, python-format
msgid "%d video sent for sealing."
msgid_plural "%d videos sent for sealing."
msgstr[0] "%d vídeo enviado para selagem."
msgstr[1] "%d vídeos enviados para selagem."

msgid "Nothing to seal among the selected videos."
msgstr "Nada para selar entre os vídeos selecionados."

msgid "Watched"
msgstr "Assistido"

msgid "Minutes"
msgstr "Minutos"

msgid "VidLock"
msgstr "VidLock"

#, python-format
msgid ""
"  %(finished)s of %(audience)s finished, %(started)s started, %(waiting)s "
"not yet"
msgstr ""
"  %(finished)s de %(audience)s terminaram, %(started)s começaram, "
"%(waiting)s ainda não"

#, python-format
msgid "  %(finished)s finished of %(started)s who started"
msgstr "  %(finished)s terminaram de %(started)s que começaram"

#, python-format
msgid "  %(count)s stopped and have not come back for %(days)s days"
msgstr "  %(count)s pararam e não voltaram há %(days)s dias"

#, python-format
msgid "  most who stop, stop around %(at)s"
msgstr "  a maioria de quem para, para por volta de %(at)s"

#, python-format
msgid ""
"  %(at)s is replayed %(ratio)sx more than the rest: worth explaining again?"
msgstr ""
"  %(at)s é revisto %(ratio)sx mais que o resto: vale explicar de novo?"

#, python-format
msgid "Lesson report: %s"
msgstr "Relatório da aula: %s"

msgid "A lesson is waiting for you"
msgstr "Uma aula está esperando por você"

#, python-format
msgid "You have not started \"%s\" yet."
msgstr "Você ainda não começou \"%s\"."

msgid "This link has expired. Reload the page."
msgstr "Este link expirou. Recarregue a página."

msgid "Playback is paused on this account. Please contact support."
msgstr ""
"A reprodução está pausada nesta conta. Entre em contato com o suporte."

msgid "This account is watching on another device."
msgstr "Esta conta está assistindo em outro dispositivo."

msgid "Forbidden"
msgstr "Proibido"

msgid "Too many requests."
msgstr "Pedidos demais."

#, python-format
msgid "The file is %(size)s MB; the limit is %(limit)s MB."
msgstr "O arquivo tem %(size)s MB; o limite é %(limit)s MB."

msgid "Upload an MP4, M4V or MOV video."
msgstr "Envie um vídeo MP4, M4V ou MOV."

msgid "The file is empty."
msgstr "O arquivo está vazio."

msgid "This upload has expired. Choose the file again."
msgstr "Este envio expirou. Escolha o arquivo novamente."

msgid "The upload did not finish. Choose the file again."
msgstr "O envio não terminou. Escolha o arquivo novamente."

msgid "This upload has already been used."
msgstr "Este envio já foi usado."

msgid "Sign in to upload."
msgstr "Entre para enviar."

msgid "You may not upload videos."
msgstr "Você não pode enviar vídeos."
