msgid "Protection"
msgstr "Protección"

msgid "Sealed"
msgstr "Sellado"

msgid "Sealing…"
msgstr "Sellando…"

msgid "Failed"
msgstr "Error"

msgid "Not sealable"
msgstr "No sellable"

msgid "Not sealed"
msgstr "Sin sellar"

msgid "Duration"
msgstr "Duración"

msgid "Seal again (unsealed or failed videos)"
msgstr "Sellar de nuevo (vídeos sin sellar o con error)"

#, python-format
msgid "%d video sent for sealing."
msgid_plural "%d videos sent for sealing."
msgstr[0] "%d vídeo enviado para sellar."
msgstr[1] "%d vídeos enviados para sellar."
msgstr[2] "%d vídeos enviados para sellar."

msgid "Nothing to seal among the selected videos."
msgstr "No hay nada que sellar entre los vídeos seleccionados."

msgid "Watched"
msgstr "Visto"

msgid "Minutes"
msgstr "Minutos"

msgid "VidLock"
msgstr "VidLock"

#, python-format
msgid ""
"  %(finished)s of %(audience)s finished, %(started)s started, %(waiting)s "
"not yet"
msgstr ""
"  %(finished)s de %(audience)s terminaron, %(started)s empezaron, "
"%(waiting)s todavía no"

#, python-format
msgid "  %(finished)s finished of %(started)s who started"
msgstr "  %(finished)s terminaron de %(started)s que empezaron"

#, python-format
msgid "  %(count)s stopped and have not come back for %(days)s days"
msgstr "  %(count)s se detuvieron y no han vuelto en %(days)s días"

#, python-format
msgid "  most who stop, stop around %(at)s"
msgstr "  la mayoría de quienes se detienen lo hacen hacia %(at)s"

#, python-format
msgid ""
"  %(at)s is replayed %(ratio)sx more than the rest: worth explaining again?"
msgstr ""
"  %(at)s se repite %(ratio)sx más que el resto: ¿vale la pena explicarlo de "
"nuevo?"

#, python-format
msgid "Lesson report: %s"
msgstr "Informe de la lección: %s"

msgid "A lesson is waiting for you"
msgstr "Una lección te espera"

#, python-format
msgid "You have not started \"%s\" yet."
msgstr "Todavía no has empezado «%s»."

msgid "This link has expired. Reload the page."
msgstr "Este enlace ha caducado. Recarga la página."

msgid "Playback is paused on this account. Please contact support."
msgstr "La reproducción está pausada en esta cuenta. Contacta con soporte."

msgid "This account is watching on another device."
msgstr "Esta cuenta está viendo en otro dispositivo."

msgid "Forbidden"
msgstr "Prohibido"

msgid "Too many requests."
msgstr "Demasiadas solicitudes."
