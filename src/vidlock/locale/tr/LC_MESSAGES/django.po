msgid "Protection"
msgstr "Koruma"

msgid "Sealed"
msgstr "Mühürlü"

msgid "Sealing…"
msgstr "Mühürleniyor…"

msgid "Failed"
msgstr "Başarısız"

msgid "Not sealable"
msgstr "Mühürlenemez"

msgid "Not sealed"
msgstr "Mühürlenmedi"

msgid "Duration"
msgstr "Süre"

msgid "Seal again (unsealed or failed videos)"
msgstr "Yeniden mühürle (mühürlenmemiş veya başarısız videolar)"

#, python-format
msgid "%d video sent for sealing."
msgid_plural "%d videos sent for sealing."
msgstr[0] "%d video mühürlemeye gönderildi."
msgstr[1] "%d video mühürlemeye gönderildi."

msgid "Nothing to seal among the selected videos."
msgstr "Seçilen videolar arasında mühürlenecek bir şey yok."

msgid "Watched"
msgstr "İzlenen"

msgid "Minutes"
msgstr "Dakika"

msgid "VidLock"
msgstr "VidLock"

#, python-format
msgid ""
"  %(finished)s of %(audience)s finished, %(started)s started, %(waiting)s "
"not yet"
msgstr ""
"  %(audience)s kişiden %(finished)s bitirdi, %(started)s başladı, "
"%(waiting)s henüz başlamadı"

#, python-format
msgid "  %(finished)s finished of %(started)s who started"
msgstr "  başlayan %(started)s kişiden %(finished)s bitirdi"

#, python-format
msgid "  %(count)s stopped and have not come back for %(days)s days"
msgstr "  %(count)s kişi durdu ve %(days)s gündür dönmedi"

#, python-format
msgid "  most who stop, stop around %(at)s"
msgstr "  duranların çoğu %(at)s civarında duruyor"

#, python-format
msgid ""
"  %(at)s is replayed %(ratio)sx more than the rest: worth explaining again?"
msgstr ""
"  %(at)s diğer kısımlardan %(ratio)s kat fazla tekrar izleniyor: yeniden "
"anlatmaya değer mi?"

#, python-format
msgid "Lesson report: %s"
msgstr "Ders raporu: %s"

msgid "A lesson is waiting for you"
msgstr "Seni bekleyen bir ders var"

#, python-format
msgid "You have not started \"%s\" yet."
msgstr "\"%s\" dersine henüz başlamadın."

msgid "This link has expired. Reload the page."
msgstr "Bu bağlantının süresi doldu. Sayfayı yenileyin."

msgid "Playback is paused on this account. Please contact support."
msgstr "Bu hesapta oynatma duraklatıldı. Lütfen destekle iletişime geçin."

msgid "This account is watching on another device."
msgstr "Bu hesap başka bir cihazda izliyor."

msgid "Forbidden"
msgstr "Yasak"

msgid "Too many requests."
msgstr "Çok fazla istek."

#, python-format
msgid "The file is %(size)s MB; the limit is %(limit)s MB."
msgstr "Dosya %(size)s MB; sınır %(limit)s MB."

msgid "Upload an MP4, M4V or MOV video."
msgstr "MP4, M4V veya MOV video yükleyin."

msgid "The file is empty."
msgstr "Dosya boş."

msgid "This upload has expired. Choose the file again."
msgstr "Bu yüklemenin süresi doldu. Dosyayı yeniden seçin."

msgid "The upload did not finish. Choose the file again."
msgstr "Yükleme tamamlanmadı. Dosyayı yeniden seçin."

msgid "This upload has already been used."
msgstr "Bu yükleme zaten kullanıldı."

msgid "Sign in to upload."
msgstr "Yüklemek için giriş yapın."

msgid "You may not upload videos."
msgstr "Video yükleme izniniz yok."
